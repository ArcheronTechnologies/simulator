node_modules/
dist/

# Verification debug artifact (regenerated by `npm run verify`)
scripts/.verify-screenshot.png

# Generated data — reproducible via scripts/fetch_overpass.mjs.
# The compact central-core tileset (committed below) works out of the box;
# `npm run data:all` regenerates the full municipality set in this same
# directory for local exploration, which is intentionally NOT committed —
# this rule only blocks new/untracked tiles from being added, it does not
# untrack the already-committed core files.
public/tiles/*.json
!public/tiles/manifest.json
data/cache/

# Generated character asset — reproducible via scripts/fetch_character.mjs
public/assets/*.glb
public/assets/*.gltf
public/assets/*.bin
