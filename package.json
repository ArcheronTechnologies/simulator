{
  "name": "lund-walkable-simulation",
  "version": "0.1.0",
  "description": "A walkable 1:1 digital simulation of Lund, Sweden, built from real OpenStreetMap data.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:core": "node scripts/fetch_overpass.mjs --core",
    "data:all": "node scripts/fetch_overpass.mjs --all",
    "fetch:character": "node scripts/fetch_character.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "three": "^0.185.0",
    "three-mesh-bvh": "^0.9.9"
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "playwright": "^1.55.0"
  }
}
